PORT=3000

# YouTube Data API v3 키 (Google Cloud Console에서 발급)
# 미설정 시 유튜브 소스는 자동으로 건너뜀
youtube_data_api_key=your-youtube-api-key-here

# Pinterest: API 키 불필요(비공식 내부 검색 API 직접 호출).
# 아래는 선택 사항 — 로그인 세션 쿠키를 넣으면 결과 품질이 나아질 수 있으나,
# 없어도 공개 검색은 동작한다. 미설정이면 빈 쿠키로 요청.
# PINTEREST_COOKIE=_pinterest_sess=...; csrftoken=...

# 네이버 오픈 API (developers.naver.com 앱 등록 — 검색 API + 데이터랩 권한)
# 밈 활성도 측정 주력 소스. 둘 다 없으면 네이버 크롤러 3종은 조용히 스킵.
# NAVER_CLIENT_ID=your-naver-client-id
# NAVER_CLIENT_SECRET=your-naver-client-secret
