# 실제 값은 .env 에 넣으세요 (.env 는 git 제외).

# Hugging Face 이미지 생성 (기본). hf.co/settings/tokens 에서
# "Inference Providers" 권한(Read)으로 발급.
HF_TOKEN=your-hf-token
# 선택: 기본 black-forest-labs/FLUX.1-schnell
HF_IMAGE_MODEL=black-forest-labs/FLUX.1-schnell

# Kling (영상 생성용 — 이미지는 계정 잔액 부족으로 막힘). 단일 키를 Bearer 로 사용.
KLING_API_KEY=your-kling-api-key
KLING_BASE=https://api-singapore.klingai.com
