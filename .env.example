# 실제 값은 .env 에 넣으세요 (.env 는 git 제외).

# Hugging Face 이미지 생성. hf.co/settings/tokens 에서
# "Inference Providers" 권한(Read)으로 발급.
HF_TOKEN=your-hf-token
# 선택: 기본 black-forest-labs/FLUX.1-schnell
HF_IMAGE_MODEL=black-forest-labs/FLUX.1-schnell
# 선택: 기본 replicate (이 네트워크에서 검증됨)
HF_PROVIDER=replicate

# 이미지 검색(Bing)은 API 키가 필요 없습니다.

# Supabase (DB/Auth). Supabase 대시보드 > Project Settings > API 에서 확인.
# anon 키는 프론트 노출 안전(RLS로 방어). service_role 키는 절대 프론트에 넣지 말 것.
PUBLIC_SUPABASE_URL=https://your-project.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# 관리자 페이지(/admin). 아래 둘 다 서버 전용(절대 프론트/공개 금지).
# ADMIN_PASSWORD: /admin 로그인 비밀번호(원하는 값).
# SUPABASE_SERVICE_ROLE_KEY: Supabase 대시보드 > API > service_role 키.
ADMIN_PASSWORD=your-admin-password
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
