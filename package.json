{
  "name": "memedics",
  "version": "1.0.0",
  "description": "memedics — 한국 커뮤니티 밈 트렌드 사전",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "dev:server": "node --env-file-if-exists=.env --watch server.js",
    "start:server": "node --env-file-if-exists=.env server.js",
    "crawl": "node --env-file-if-exists=.env scripts/crawl-once.js"
  },
  "dependencies": {
    "express": "^4.21.0"
  },
  "devDependencies": {
    "@inlang/paraglide-js": "^2.22.0",
    "@sveltejs/adapter-vercel": "^6.3.4",
    "@sveltejs/kit": "^2.63.0",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "svelte": "^5.56.1",
    "svelte-check": "^4.6.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.16"
  }
}
